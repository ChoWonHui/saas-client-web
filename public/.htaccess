# 정적 호스팅(카페24)용 설정. public/ 에 두어 vite build 가 dist/ 로 그대로 복사한다.

# SPA 라우팅. react-router 의 /:tenantCode/:tableCode 는 서버에 실제 파일이 없다.
# 존재하지 않는 경로는 전부 index.html 로 넘겨 라우팅을 브라우저가 처리하게 한다.
# (이게 없으면 주소 직접 입력·새로고침·QR 스캔 진입이 전부 404 가 된다)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 파비콘은 SVG 한 장만 둔다. 브라우저·크롤러는 관례적으로 /favicon.ico 를 먼저 찾는데,
  # 아래 규칙이 없으면 그 요청이 SPA 폴백에 걸려 index.html(HTML)을 이미지로 받는다.
  RewriteRule ^favicon\.ico$ /favicon.svg [L,R=301]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# 파일명에 콘텐츠 해시가 박히는 에셋은 영구 캐시해도 안전하다.
# index.html 은 매 배포마다 내용이 바뀌므로 절대 캐시하지 않는다.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
